# Use real for the Hugging Face Qwen model served through Ollama.
# Use mock for tests and checking the API without any LLM download.
AGENT_BACKEND=real
OLLAMA_MODEL=qwen3:4b-instruct-2507-q4_K_M
OLLAMA_HOST=http://localhost:11434
DATABASE_PATH=data/shop.duckdb
CHECKPOINT_PATH=data/checkpoints.sqlite
MAX_ATTEMPTS=3
